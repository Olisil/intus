---
// The viewer is plain HTML + JS; its files live in public/.
// Webflow Cloud sets the base path from the environment's mount path (e.g. /intus) at build time;
// <base> makes every relative URL resolve under it, with or without a trailing slash.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<!-- Added to the home screen, the tour opens without the browser's bars (the only full screen iPhone allows) -->
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black">
<base href={base}>
<!-- Where tours are stored, e.g. your R2 bucket: content="https://pub-xxxx.r2.dev/". Empty = public/tours/ in this repo. -->
<meta name="intus-tours" content="https://pub-3e4122c4b21f4bbda45a2627f41fe31d.r2.dev">
<!-- Anonymous visit statistics: the intus-stats Worker, then Probe (space separated; empty = off) -->
<meta name="intus-stats" content="https://intus-stats.oliver-44b.workers.dev https://probe.nassau.se/app/api/tour/zs_ffy3wv7dbzd5z2m5">
<title>Walkthrough</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400&family=Inter:wght@400;500&display=swap" rel="stylesheet">
<link rel="modulepreload" href="lib/playcanvas.mjs">
<link rel="modulepreload" href="lib/rapier.mjs">
<link rel="modulepreload" href="map.js">
<link rel="modulepreload" href="controls.js">
<link rel="modulepreload" href="gyro.js">
<link rel="modulepreload" href="stats.js">
<link rel="modulepreload" href="measure.js">
<link rel="modulepreload" href="heat.js">
<link rel="stylesheet" href="style.css">
</head>
<body>
<!--intus:body-->
<canvas id="c"></canvas>
<canvas id="measureLayer" class="measure-layer"></canvas>

<!-- Intro / pause screen -->
<div id="intro" class="screen">
  <div class="intro-grid">
    <div class="card">
      <p class="eyebrow" id="eyebrow"></p>
      <h1 id="title">Loading…</h1>
      <p class="subtitle" id="subtitle"></p>
      <div class="progress" id="progress"><div></div></div>
      <p class="progress-text" id="progressText"></p>
      <button id="enter" class="enter" disabled>
        <span id="enterLabel">Loading</span>
      </button>
      <div class="rooms hidden" id="rooms"><p class="rooms-title" id="roomsTitle"></p><div id="roomList"></div></div>
      <div class="keys how" id="keys"></div>
      <div class="quality hidden" id="quality"><span id="qualityLabel"></span><div class="qseg" id="qualitySeg"></div></div>
    </div>
    <div class="intro-map hidden" id="introMap">
      <canvas id="mapLarge"></canvas>
      <select id="mapFloor" class="floor-select hidden" aria-label="Floor"></select>
      <p class="map-hint" id="mapHint"></p>
    </div>
  </div>
</div>

<!-- Error screen -->
<div id="error" class="screen hidden"><div class="card"><h1>Can't open this tour</h1><p class="subtitle" id="errorText"></p></div></div>

<!-- In-tour UI -->
<div id="hud" class="hidden">
  <div class="badge" id="badge"><span id="badgeTitle"></span><span class="badge-room hidden" id="badgeRoom"></span></div>
  <div class="room-toast" id="roomToast"></div>
  <div class="hint" id="hint"></div>
  <div class="dev hidden" id="dev"></div>
  <div class="keypad hidden" id="keypad" aria-hidden="true"></div>
  <div class="tools hidden" id="tools">
    <button class="round-btn hidden" id="fsBtn" aria-pressed="false"></button>
    <div class="fs-help hidden" id="fsHelp" role="dialog"><button class="fs-help-x" id="fsHelpX"></button><b id="fsHelpTitle"></b><p id="fsHelpText"></p></div>
    <button class="round-btn gyro-btn hidden" id="gyroBtn" aria-pressed="false"></button>
  </div>
  <aside class="drawer hidden" id="drawer">
    <button class="drawer-tab" id="drawerTab" aria-expanded="false" aria-controls="drawerBody">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 6.5 9 12l5.5 5.5"/></svg>
      <em class="count hidden" id="drawerCount"></em>
    </button>
    <div class="drawer-body" id="drawerBody">
      <p class="drawer-title" id="drawerTitle"></p>
      <button class="tool-row" id="toolMeasure" aria-pressed="false"></button>
      <div class="measure-sec hidden" id="measureSec">
        <p class="mp-tip" id="mpTip"></p>
        <ol class="mp-list" id="mpList"></ol>
        <div class="mp-actions"><button class="mp-clear" id="mpClear"></button><button class="mp-done" id="mpDone"></button></div>
      </div>
    </div>
  </aside>
  <div class="measure-cross hidden" id="measureCross"><i></i></div>
  <div class="mini-wrap hidden" id="miniWrap">
    <canvas id="mapSmall" class="mini"></canvas>
    <select id="miniFloor" class="floor-select mini-floor hidden" aria-label="Floor"></select>
  </div>
</div>

<!-- Touch controls -->
<!-- the whole lower-left corner takes the thumb, not only the drawn stick -->
<div id="stickZone" class="hidden"><div id="stick"><div id="knob"></div></div></div>
<!--/intus:body-->

<script is:inline type="module" src="viewer.js"></script>
</body>
</html>
