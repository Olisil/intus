---
// The viewer is plain HTML + JS; its files live in public/.
// Webflow Cloud sets the base path from the environment's mount path (e.g. /intus) at build time;
// <base> makes every relative URL resolve under it, with or without a trailing slash.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<base href={base}>
<!-- Where tours are stored, e.g. your R2 bucket: content="https://pub-xxxx.r2.dev/". Empty = public/tours/ in this repo. -->
<meta name="intus-tours" content="https://pub-3e4122c4b21f4bbda45a2627f41fe31d.r2.dev">
<title>Walkthrough</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400&family=Inter:wght@400;500&display=swap" rel="stylesheet">
<link rel="modulepreload" href="lib/playcanvas.mjs">
<link rel="modulepreload" href="lib/rapier.mjs">
<link rel="modulepreload" href="map.js">
<link rel="stylesheet" href="style.css">
</head>
<body>
<!--intus:body-->
<canvas id="c"></canvas>

<!-- Intro / pause screen -->
<div id="intro" class="screen">
  <div class="intro-grid">
    <div class="card">
      <p class="eyebrow" id="eyebrow"></p>
      <h1 id="title">Loading…</h1>
      <p class="subtitle" id="subtitle"></p>
      <div class="progress" id="progress"><div></div></div>
      <p class="progress-text" id="progressText"></p>
      <button id="enter" class="enter" disabled>
        <span id="enterLabel">Loading</span>
      </button>
      <div class="rooms hidden" id="rooms"><p class="rooms-title" id="roomsTitle"></p><div id="roomList"></div></div>
      <div class="keys" id="keys"></div>
      <div class="quality hidden" id="quality"><span id="qualityLabel"></span><div class="qseg" id="qualitySeg"></div></div>
    </div>
    <div class="intro-map hidden" id="introMap">
      <canvas id="mapLarge"></canvas>
      <select id="mapFloor" class="floor-select hidden" aria-label="Floor"></select>
      <p class="map-hint" id="mapHint"></p>
    </div>
  </div>
</div>

<!-- Error screen -->
<div id="error" class="screen hidden"><div class="card"><h1>Can't open this tour</h1><p class="subtitle" id="errorText"></p></div></div>

<!-- In-tour UI -->
<div id="hud" class="hidden">
  <div class="badge" id="badge"><span id="badgeTitle"></span><span class="badge-room hidden" id="badgeRoom"></span></div>
  <div class="room-toast" id="roomToast"></div>
  <div class="hint" id="hint"></div>
  <div class="dev hidden" id="dev"></div>
  <div class="keypad hidden" id="keypad" aria-hidden="true">
    <div class="kp-group">
      <span class="kp" data-dir="f" style="grid-area:u">W</span>
      <span class="kp" data-dir="l" style="grid-area:l">A</span>
      <span class="kp" data-dir="b" style="grid-area:d">S</span>
      <span class="kp" data-dir="r" style="grid-area:r">D</span>
    </div>
    <div class="kp-group">
      <span class="kp" data-dir="f" style="grid-area:u"><svg viewBox="0 0 12 12" style="transform:rotate(0deg)"><path d="M6 2.2 2.6 7.4h6.8z" fill="currentColor"/></svg></span>
      <span class="kp" data-dir="l" style="grid-area:l"><svg viewBox="0 0 12 12" style="transform:rotate(-90deg)"><path d="M6 2.2 2.6 7.4h6.8z" fill="currentColor"/></svg></span>
      <span class="kp" data-dir="b" style="grid-area:d"><svg viewBox="0 0 12 12" style="transform:rotate(180deg)"><path d="M6 2.2 2.6 7.4h6.8z" fill="currentColor"/></svg></span>
      <span class="kp" data-dir="r" style="grid-area:r"><svg viewBox="0 0 12 12" style="transform:rotate(90deg)"><path d="M6 2.2 2.6 7.4h6.8z" fill="currentColor"/></svg></span>
    </div>
  </div>
  <div class="mini-wrap hidden" id="miniWrap">
    <canvas id="mapSmall" class="mini"></canvas>
    <select id="miniFloor" class="floor-select mini-floor hidden" aria-label="Floor"></select>
  </div>
</div>

<!-- Touch controls -->
<div id="stick" class="hidden">
  <span class="st-arrow" data-dir="f" style="top:7px;left:50%;margin-left:-7px"><svg viewBox="0 0 12 12" style="transform:rotate(0deg)"><path d="M6 2.2 2.6 7.4h6.8z" fill="currentColor"/></svg></span>
  <span class="st-arrow" data-dir="b" style="bottom:7px;left:50%;margin-left:-7px"><svg viewBox="0 0 12 12" style="transform:rotate(180deg)"><path d="M6 2.2 2.6 7.4h6.8z" fill="currentColor"/></svg></span>
  <span class="st-arrow" data-dir="l" style="left:7px;top:50%;margin-top:-7px"><svg viewBox="0 0 12 12" style="transform:rotate(-90deg)"><path d="M6 2.2 2.6 7.4h6.8z" fill="currentColor"/></svg></span>
  <span class="st-arrow" data-dir="r" style="right:7px;top:50%;margin-top:-7px"><svg viewBox="0 0 12 12" style="transform:rotate(90deg)"><path d="M6 2.2 2.6 7.4h6.8z" fill="currentColor"/></svg></span>
  <div id="knob"></div>
</div>
<!--/intus:body-->

<script is:inline type="module" src="viewer.js"></script>
</body>
</html>
