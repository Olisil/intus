---
// Hidden statistics page for brokers and Nassau: not linked anywhere, not indexed, sign-in required.
// The data comes from the intus-stats Cloudflare Worker (meta "intus-stats" below).
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="sv">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow, noarchive">
<base href={base}>
<meta name="intus-tours" content="https://pub-3e4122c4b21f4bbda45a2627f41fe31d.r2.dev">
<!-- The intus-stats Worker, e.g. https://intus-stats.<your-subdomain>.workers.dev -->
<meta name="intus-stats" content="">
<title>intus · statistik</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="stats.css">
</head>
<body>
<header class="top hidden" id="top">
  <div class="brand"><b>intus</b><span>statistik</span></div>
  <select id="tourSel" class="sel" aria-label="Visning"></select>
  <div class="seg" id="period">
    <button data-d="7">7 dagar</button><button data-d="30" class="on">30 dagar</button><button data-d="90">90 dagar</button><button data-d="0">Allt</button>
  </div>
  <div class="spacer"></div>
  <button class="btn small ghost hidden" id="usersBtn">Konton</button>
  <div class="who" id="who"></div>
  <button class="btn small ghost" id="logout">Logga ut</button>
</header>

<!-- sign in / first-time setup -->
<main class="auth hidden" id="auth">
  <form class="panel narrow" id="loginForm">
    <h1>intus <em>statistik</em></h1>
    <p class="lead">Logga in för att se hur besökarna rör sig i visningarna.</p>
    <label class="f"><span>E-post</span><input type="email" id="lEmail" autocomplete="username" required></label>
    <label class="f"><span>Lösenord</span><input type="password" id="lPass" autocomplete="current-password" required></label>
    <p class="msg" id="lMsg"></p>
    <button class="btn primary big" type="submit">Logga in</button>
  </form>
  <form class="panel narrow hidden" id="setupForm">
    <h1>Skapa administratör</h1>
    <p class="lead">Första gången: skapa ditt konto. Koden är den <b>SETUP_CODE</b> du lade in i Cloudflare.</p>
    <label class="f"><span>Kod</span><input type="password" id="sCode" required></label>
    <label class="f"><span>Namn</span><input type="text" id="sName"></label>
    <label class="f"><span>E-post</span><input type="email" id="sEmail" autocomplete="username" required></label>
    <label class="f"><span>Lösenord <em>minst 10 tecken</em></span><input type="password" id="sPass" autocomplete="new-password" minlength="10" required></label>
    <p class="msg" id="sMsg"></p>
    <button class="btn primary big" type="submit">Skapa konto</button>
  </form>
  <div class="panel narrow hidden" id="noConfig">
    <h1>Statistiken är inte kopplad än</h1>
    <p class="lead">Lägg in adressen till intus-stats-tjänsten i sidans <code>intus-stats</code>-fält.</p>
  </div>
</main>

<main class="dash hidden" id="dash">
  <section class="hero">
    <div>
      <p class="eyebrow" id="tEyebrow"></p>
      <h1 id="tTitle"></h1>
      <p class="sub" id="tSub"></p>
    </div>
    <div class="hero-actions">
      <a class="btn" id="open3d" target="_blank">3D-värmekarta</a>
      <a class="btn ghost" id="openTour" target="_blank">Öppna visningen</a>
    </div>
  </section>

  <section class="kpis" id="kpis"></section>

  <section class="grid2">
    <div class="panel">
      <div class="panel-h"><h2>Besök per dag</h2></div>
      <div id="daily" class="daily"></div>
    </div>
    <div class="panel">
      <div class="panel-h"><h2>Rummen</h2><span class="hint">andel besökare som kom dit · snittid i rummet</span></div>
      <div id="rooms" class="rooms"></div>
    </div>
  </section>

  <section class="panel">
    <div class="panel-h">
      <h2>Värmekarta</h2>
      <div class="seg" id="levels"></div>
      <div class="layers" id="layers">
        <label><input type="checkbox" data-l="walk" checked><i class="sw walk"></i>Var man gick</label>
        <label><input type="checkbox" data-l="look" checked><i class="sw look"></i>Vad man tittade på</label>
        <label><input type="checkbox" data-l="path"><i class="sw path"></i>Rutter</label>
      </div>
    </div>
    <div class="heat-wrap" id="heatWrap">
      <canvas id="heatBg"></canvas><canvas id="heat"></canvas><canvas id="heatTop"></canvas>
      <div class="legend"><span>lite</span><i></i><span>mycket</span></div>
      <div class="replay hidden" id="replayBar"><span id="replayText"></span><button class="btn small" id="replayStop">Stäng</button></div>
    </div>
  </section>

  <section class="panel">
    <div class="panel-h"><h2>Senaste besöken</h2><span class="hint">klicka på ett besök för att spela upp rutten</span>
      <div class="spacer"></div><button class="btn small ghost danger hidden" id="clearBtn">Rensa statistiken</button></div>
    <div class="visits" id="visits"></div>
  </section>
  <p class="empty hidden" id="empty">Inga besök i den här perioden än.</p>
</main>

<!-- accounts -->
<div class="modal hidden" id="users">
  <div class="panel modal-card">
    <div class="panel-h"><h2>Konton</h2><div class="spacer"></div><button class="btn small ghost" data-close>Stäng</button></div>
    <p class="lead">Mäklare ser bara de visningar du väljer. Lösenordet visas en gång – skicka det till personen.</p>
    <div id="userList" class="user-list"></div>
    <form id="userForm" class="user-form">
      <h3>Lägg till konto</h3>
      <div class="grid2 tight">
        <label class="f"><span>Namn</span><input type="text" id="uName"></label>
        <label class="f"><span>E-post</span><input type="email" id="uEmail" required></label>
      </div>
      <label class="f"><span>Roll</span><select id="uRole" class="sel"><option value="broker">Mäklare</option><option value="admin">Administratör (ser allt)</option></select></label>
      <div class="f" id="uToursWrap"><span>Visningar</span><div class="chips" id="uTours"></div></div>
      <p class="msg" id="uMsg"></p>
      <button class="btn primary" type="submit">Skapa konto</button>
    </form>
  </div>
</div>
<div class="modal hidden" id="pwModal">
  <div class="panel modal-card narrow">
    <h2 id="pwTitle">Lösenord</h2>
    <p class="lead" id="pwText"></p>
    <div class="pw"><code id="pwValue"></code><button class="btn small" id="pwCopy">Kopiera</button></div>
    <div class="row-end"><button class="btn primary" data-close>Klar</button></div>
  </div>
</div>
<div class="toast" id="toast"></div>

<script type="module" src="stats-app.js"></script>
</body>
</html>
